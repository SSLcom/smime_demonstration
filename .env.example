# Copy to .env (gitignored) and fill in.

# sandbox (default) or production. Production also requires
# --i-understand-this-spends-money on every command.
SSLCOM_ENV=sandbox

# SWS API credentials from your SSL.com sandbox account.
SSLCOM_ACCOUNT_KEY=
SSLCOM_SECRET_KEY=

# A real mailbox you can read. SSL.com sends the validation email here, and you
# click the link in it. Used as the default --email and by the live tests.
SSLCOM_TEST_EMAIL=

# Optional: an email domain whose DNS you control, for the domain-validation
# flow (validate the domain once, then issue for any address on it without
# per-mailbox clicks). Commands that use it also accept --domain.
SSLCOM_TEST_DOMAIN=
